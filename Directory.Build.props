<Project>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- Holds the style rules of .editorconfig in the build, so a break fails it like any other warning. -->
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <Company>PinkRooster</Company>
        <PackageIcon>icon.png</PackageIcon>
        <AnalysisLevel>latest</AnalysisLevel>
    </PropertyGroup>

    <!-- One version for every package in the repository; release.yml checks the tag against it. -->
    <PropertyGroup>
        <Version>0.1.0-preview.1</Version>
        <Authors>PinkRooster</Authors>
        <Copyright>Copyright (c) 2026 Jan Versteeg</Copyright>
        <PackageReleaseNotes>See https://github.com/pinkroosterai/PinkRooster.ProviderConfig/blob/main/CHANGELOG.md</PackageReleaseNotes>
        <PackageProjectUrl>https://github.com/pinkroosterai/PinkRooster.ProviderConfig</PackageProjectUrl>
        <RepositoryUrl>https://github.com/pinkroosterai/PinkRooster.ProviderConfig</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <!-- On CI the PDBs carry repository paths instead of the build machine's, so SourceLink resolves and the build is deterministic. -->
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>
</Project>
